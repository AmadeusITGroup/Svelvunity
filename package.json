{
	"name": "@amadeus-it-group/svelvunity",
	"description": "Reusable components and utilities svelte library.",
	"version": "0.0.0",
	"bugs": "https://github.com/AmadeusITGroup/Svelvunity/issues",
	"license": "MIT",
	"type": "module",
	"keywords": [
		"accordion",
		"datepicker",
		"components",
		"pagination",
		"popover",
		"reusable",
		"slider",
		"svelte",
		"tabs",
		"tailwindcss",
		"toast",
		"tooltip"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AmadeusITGroup/Svelvunity.git"
	},
	"engines": {
		"npm": ">=11.2.0",
		"node": ">=22.13.0"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@eslint/compat": "^2.0.3",
		"@floating-ui/dom": "^1.7.6",
		"@tailwindcss/postcss": "^4.3.2",
		"htm": "^3.1.1",
		"svelte-preprocess": "^6.0.5",
		"tailwind-merge": "^3.3.1",
		"typescript-eslint": "^8.54.0"
	},
	"overrides": {
		"cookie": "^0.7.0",
		"flatted": "^3.4.0",
		"undici": "^7.28.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.69.2",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.3.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.2.8",
		"@testing-library/user-event": "14.6.1",
		"@typescript-eslint/eslint-plugin": "^8.63.0",
		"@typescript-eslint/parser": "^8.63.0",
		"@vitest/coverage-v8": "^4.1.10",
		"@vitest/ui": "^4.1.0",
		"autoprefixer": "^10.5.2",
		"@eslint/js": "^10.0.0",
		"eslint": "^10.1.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.6.0",
		"jsdom": "^29.0.1",
		"postcss": "^8.5.16",
		"postcss-load-config": "^6.0.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.1",
		"publint": "^0.3.18",
		"svelte": "^5.55.7",
		"svelte-check": "^4.7.2",
		"tailwindcss": "^4.3.0",
		"tslib": "^2.8.1",
		"typescript": "^6.0.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.0"
	},
	"scripts": {
		"dev": "svelte-kit sync && vite dev",
		"build": "svelte-kit sync && vite build && npm run package && rm dist/assets/images/svelvunity-logo.png",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --plugin prettier-plugin-svelte . --check . && eslint .",
		"format": "prettier --plugin prettier-plugin-svelte . --write .",
		"test": "vitest",
		"coverage": "vitest run --coverage"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts"
}
